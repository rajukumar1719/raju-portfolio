# ==============================================================================
# Portfolio Contact Form Environment Variables
# ==============================================================================
# Add these variables to your Vercel Project Settings (Settings -> Environment Variables)
# and create a local .env file for local development testing.

# Destination email for all contact form inquiries (defaults to rajukumarranchi17@gmail.com if omitted)
CONTACT_TO_EMAIL=rajukumarranchi17@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: Resend API (Recommended - Free & Instant)
# Sign up at https://resend.com, generate an API key, and paste it below:
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
# Optional custom sender (defaults to "Portfolio Contact <onboarding@resend.dev>"):
# RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# OPTION 2: Gmail SMTP / App Password
# Generate an App Password at https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# GMAIL_USER=rajukumarranchi17@gmail.com
# GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# ------------------------------------------------------------------------------
# OPTION 3: Custom SMTP (SendGrid, Mailgun, Brevo, AWS SES, etc.)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
